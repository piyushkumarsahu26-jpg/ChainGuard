# ChainGuard AI Service — environment variables
# Copy to .env and adjust as needed. See config/settings.py for defaults.

# --- Server ---
PORT=8000
ENV=development

# --- Model registry ---
MODEL_DIR=models/weights
ACTIVE_MODEL_VERSION=

# --- Backend integration (not used by any code yet — Sprint AI-1 has no
# inference/detection-client code; reserved for a future sprint) ---
BACKEND_URL=http://localhost:5000/api/v1
AI_SERVICE_JWT=

# --- API key (Sprint AI-4B): guards /models and /predict/* from the Node
# backend's calls. Empty = auth disabled (dev default). Must match the
# Node backend's AI_SERVICE_API_KEY exactly. ---
AI_SERVICE_API_KEY=

# --- Storage (not used by any code yet — reserved for a future sprint) ---
EVIDENCE_DIR=../backend/src/uploads/evidence

# --- Inference thresholds (not used by any code yet — reserved for a
# future sprint; the real alert-raising decision stays in the Node
# backend's detection.service.js, never duplicated here) ---
CONFIDENCE_THRESHOLD=0.5
AUTO_ALERT_THRESHOLD=0.75

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs
