{
  "info": {
    "name": "ChainGuard API",
    "description": "AI Powered End-to-End Examination Paper Integrity Monitoring System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Jane Officer\",\n  \"email\": \"jane@chainguard.local\",\n  \"password\": \"Password123!\",\n  \"role\": \"EXAM_CENTER_OFFICER\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@chainguard.local\",\n  \"password\": \"ChangeMe123!\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Refresh Token",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/refresh" }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/logout"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"ChangeMe123!\",\n  \"newPassword\": \"NewPassword456!\"\n}" },
            "url": "{{baseUrl}}/auth/change-password"
          }
        }
      ]
    },
    {
      "name": "Envelopes",
      "item": [
        {
          "name": "Create Envelope",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"exam\": \"B.Tech Semester Exam\",\n  \"subject\": \"Operating Systems\",\n  \"center\": \"Center A\"\n}" },
            "url": "{{baseUrl}}/envelopes"
          }
        },
        {
          "name": "List Envelopes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/envelopes?page=1&limit=20"
          }
        },
        {
          "name": "Get Envelope",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/envelopes/:id"
          }
        },
        {
          "name": "Get Envelope Centers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/envelopes/centers"
          }
        },
        {
          "name": "Update Envelope",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"sealStatus\": \"OPENED\"\n}" },
            "url": "{{baseUrl}}/envelopes/:id"
          }
        },
        {
          "name": "Delete Envelope",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/envelopes/:id"
          }
        }
      ]
    },
    {
      "name": "Cameras",
      "item": [
        {
          "name": "Create Camera",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Hall A Cam 1\",\n  \"ipAddress\": \"192.168.1.10\",\n  \"fps\": 25,\n  \"resolution\": \"1080p\"\n}" },
            "url": "{{baseUrl}}/cameras"
          }
        },
        {
          "name": "List Cameras",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/cameras"
          }
        },
        {
          "name": "Camera Heartbeat",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ONLINE\"\n}" },
            "url": "{{baseUrl}}/cameras/:id/heartbeat"
          }
        }
      ]
    },
    {
      "name": "Detections",
      "item": [
        {
          "name": "Submit Detection",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"cameraId\": \"<camera-uuid>\",\n  \"prediction\": \"unauthorized_material\",\n  \"confidence\": 0.87,\n  \"boundingBox\": { \"x\": 120, \"y\": 80, \"width\": 60, \"height\": 90 },\n  \"imagePath\": \"src/uploads/detections/frame123.jpg\"\n}" },
            "url": "{{baseUrl}}/detections"
          }
        },
        {
          "name": "List Detections",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/detections"
          }
        }
      ]
    },
    {
      "name": "Alerts",
      "item": [
        {
          "name": "List Alerts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/alerts"
          }
        },
        {
          "name": "Resolve Alert",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/alerts/:id/resolve"
          }
        }
      ]
    },
    {
      "name": "Custody / Tracking",
      "item": [
        {
          "name": "Scan QR",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"qrCode\": \"CHAINGUARD-ENV-...\",\n  \"location\": \"Transport Hub 1\",\n  \"eventType\": \"HANDOVER\",\n  \"remarks\": \"Handed to transport officer\"\n}" },
            "url": "{{baseUrl}}/custody/scan"
          }
        },
        {
          "name": "Tracking History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/custody/track/:envelopeId"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Generate Report",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Weekly Integrity Summary\",\n  \"type\": \"DAILY_SUMMARY\"\n}" },
            "url": "{{baseUrl}}/reports"
          }
        },
        {
          "name": "List Reports",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/reports"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/dashboard/summary"
          }
        },
        {
          "name": "Dashboard Recent Activity",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/dashboard/activity"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Officers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/users/officers"
          }
        },
        {
          "name": "Search Users (Administrator)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/users/search?q=officer&page=1&limit=20"
          }
        },
        {
          "name": "List Users (Administrator)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/users?page=1&limit=20"
          }
        },
        {
          "name": "Create User (Administrator)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Jane Auditor\",\n  \"email\": \"jane.auditor@chainguard.local\",\n  \"password\": \"Password123!\",\n  \"role\": \"AUDITOR\",\n  \"employeeId\": \"EMP-2001\",\n  \"department\": \"Compliance\"\n}" },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Get User (Administrator)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/users/:id"
          }
        },
        {
          "name": "Update User Profile (Administrator)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"department\": \"Compliance & Audit\",\n  \"phone\": \"+91-9000000000\"\n}" },
            "url": "{{baseUrl}}/users/:id"
          }
        },
        {
          "name": "Update User Status (Administrator)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": false\n}" },
            "url": "{{baseUrl}}/users/:id/status"
          }
        },
        {
          "name": "Update User Role (Administrator)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"VIEWER\"\n}" },
            "url": "{{baseUrl}}/users/:id/role"
          }
        },
        {
          "name": "Reset User Password (Administrator)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"newPassword\": \"TempPassword789!\"\n}" },
            "url": "{{baseUrl}}/users/:id/password-reset"
          }
        },
        {
          "name": "Restore User (Administrator)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/users/:id/restore"
          }
        },
        {
          "name": "Delete (Soft) User (Administrator)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/users/:id"
          }
        }
      ]
    },
    {
      "name": "Audit Logs",
      "item": [
        {
          "name": "List Audit Logs (Administrator/Auditor)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/audit-logs?page=1&limit=20"
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Scans by Month",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/analytics/scans-by-month"
          }
        },
        {
          "name": "Tamper Breakdown",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/analytics/tamper-breakdown"
          }
        },
        {
          "name": "Confidence Trend",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/analytics/confidence-trend?days=30"
          }
        },
        {
          "name": "Center Risk",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/analytics/center-risk"
          }
        },
        {
          "name": "Camera Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/analytics/camera-status"
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        { "name": "Health Check", "request": { "method": "GET", "url": "{{baseUrl}}/health" } }
      ]
    }
  ]
}
