# ==========================================
# ChainGuard Backend - Environment Variables
# ==========================================

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chainguard?schema=public"

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# QR Verification & Digital Authentication -- deliberately a separate
# secret from the JWT ones above: QR signing is a different security
# concern (data-integrity of a printed, long-lived artifact) from
# session-token issuance, and rotating one should not silently break
# the other.
QR_SIGNING_SECRET=replace_with_a_long_random_qr_signing_secret

# Cookies
# Final Verification Sprint fix: previously hardcoded to "false" here,
# which would silently override env.js's own safe default (secure
# automatically when NODE_ENV=production) in any real deployment that
# copies this file to .env without specifically noticing and removing
# this line. Left unset by default -- env.js already does the right
# thing based on NODE_ENV without any value here. Only set this
# explicitly for a real reason (e.g. a staging environment served over
# HTTPS that isn't technically NODE_ENV=production, where you'd set it
# to true; or a genuine non-HTTPS deployment, where the honest answer is
# to fix the deployment, not set this to false).
# COOKIE_SECURE=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Uploads
UPLOAD_DIR=src/uploads
MAX_UPLOAD_SIZE_MB=10

# AI Service (FastAPI - connected later)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=replace_with_ai_service_shared_secret

# Seed Admin (used by prisma/seed.js)
SEED_ADMIN_EMAIL=admin@chainguard.local
SEED_ADMIN_PASSWORD=ChangeMe123!
